<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="SauceDemo Cross-Browser Parallel Suite" parallel="tests" thread-count="2">
    <test name="Chrome Tests">
        <parameter name="browser" value="chrome"/>
        <classes>
            <class name="com.epam.training.joaquin_contreras.runners.ChromeCucumberTestRunner"/>
        </classes>
    </test>
    <test name="Edge Tests">
        <parameter name="browser" value="edge"/>
        <classes>
            <class name="com.epam.training.joaquin_contreras.runners.EdgeCucumberTestRunner"/>
        </classes>
    </test>
</suite>
